    [
      "@PREFIX/bin/critic2",
      "--version"
    ],
    [
      "@PREFIX/bin/python",
      "-c",
      "import ppafm.core, ppafm.GridUtils; from importlib.metadata import version; assert version('ppafm')=='0.4.1'; print('ppafm-native-import-ready')"
    ]
  ]
